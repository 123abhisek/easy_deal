# EasyDeal Flutter Mobile Application Environment Configuration
# API Base URL for Production and Development

# Production VPS Public Endpoint (proxied via Nginx HTTPS to FastAPI port 8000)
API_BASE_URL=https://easydealworld.com/v1/api

# Development / Android Emulator Localhost (Optional)
# API_BASE_URL_EMULATOR=http://10.0.2.2:8000/v1/api

# Razorpay Key ID (Client-side identifier only; NO secrets in client)
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
